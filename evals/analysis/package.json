{
	"name": "@cline/analysis",
	"version": "1.0.0",
	"description": "Analysis framework for Cline evaluations with failure classification and metrics",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"start": "tsx src/cli.ts",
